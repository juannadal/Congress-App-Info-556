# Copy this file to .env (in this folder or the project root) and add your key.
# Get a free Congress.gov API key at https://api.data.gov/signup/
# Used by congress_hello.sh, scripts/fetch_members.py, and scripts/fetch_sponsored_bills.py.
CONGRESS_API_KEY=your-key-here

# Optional: an email or URL that Wikimedia can use to contact you. Read only from the project-root .env
# (or the environment) by scripts/fetch_wikipedia.py.
# WIKIMEDIA_CONTACT=you@example.com
